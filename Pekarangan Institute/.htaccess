# Konfigurasi Keamanan Web Server Apache - Pekarangan Institute

# 1. Nonaktifkan index browsing direktori
Options -Indexes

# 2. Lindungi file tersembunyi (dotfiles: .git, .gitignore, dll.)
<FilesMatch "^\.">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# 3. Lindungi berkas sensitif dari akses URL langsung (.sql, .sample.php, .log)
<FilesMatch "(?i)\.(sql|sample\.php|log|ini)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# 4. Pengalihan URL tidak sengaja / salah ketik (admin/admin -> admin/index.php)
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^admin/admin/?$ /pekarangan-v2/admin/index.php [R=302,L]
</IfModule>

